{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local AI Manager",
  "version": "0.1.0",
  "identifier": "dev.localaimanager.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "本地 AI 工作台 · TTS",
        "width": 1320,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost; media-src 'self' http://127.0.0.1:* data: blob:; img-src 'self' data: blob: http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/tts-server"],
    "resources": [],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "本地 AI 模型资产管理与显存动态调度系统",
    "longDescription": "TTS 子系统：模型中心、声音库与声音设计工作台。"
  }
}
